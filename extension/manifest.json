{
  "manifest_version": 3,
  "name": "Meet AI Interpreter (BN <-> JA/EN)",
  "version": "1.5.0",
  "description": "Live Bangla <-> Japanese/English interpreter and meeting assistant for Google Meet.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Meet AI Interpreter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "key": "",
  "host_permissions": [
    "https://meet.google.com/*",
    "https://translate.cloudproductionltd.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["captions.js", "bridge.js"],
      "css": ["hud.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
