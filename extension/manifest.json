{
  "manifest_version": 3,
  "name": "Meet AI Interpreter (BN <-> JA/EN)",
  "version": "1.4.1",
  "description": "Live Bangla <-> Japanese/English interpreter and meeting assistant for Google Meet.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["captions.js", "bridge.js"],
      "css": ["hud.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
