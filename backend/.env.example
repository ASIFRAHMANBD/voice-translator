# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
# true = canned responses + a chime sound, no AI keys needed
DEMO_MODE=true
# Optional shared secret. If set, paste the same value into the HUD's Settings > API token.
API_TOKEN=
# Comma-separated. Your extension origin, e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop
# Empty = allow any chrome-extension:// origin (fine for local dev only).
ALLOWED_ORIGINS=
MAX_UPLOAD_MB=10
PROVIDER_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# Provider selection
# STT_PROVIDER: openai | groq | deepgram | custom
# LLM_PROVIDER: openai | gemini | openai-compatible (aliases: vllm, custom)
# TTS_PROVIDER: openai | elevenlabs | edge | custom
# ---------------------------------------------------------------------------
STT_PROVIDER=openai
LLM_PROVIDER=openai
TTS_PROVIDER=edge
# Backup voice when the main one fails (Edge rate limits with HTTP 429); "none" disables it
TTS_FALLBACK_PROVIDER=google-translate
# Optional per-language voice provider, e.g. TTS_PROVIDER_JA=openai while Bangla stays on edge
TTS_PROVIDER_BN=
TTS_PROVIDER_JA=
TTS_PROVIDER_EN=
# Names/terms speech recognition should spell right, e.g. "CPL, Asif, Figma, Next.js, sprint"
STT_GLOSSARY=

# OpenAI (also used for any OpenAI-compatible base URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# whisper-1 does NOT support Bangla (HTTP 400 / garbage); gpt-transcribe does
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=ash
# Tone for gpt-4o TTS models (ignored by tts-1)
OPENAI_TTS_INSTRUCTIONS=Speak like a calm, friendly professional in a business meeting. Natural pace, warm tone, clear pronunciation.

# Live simultaneous interpreter for the host's Bangla (Settings > "OpenAI live")
# Streams BN -> JA/EN speech word by word while the host talks (~$0.034/min)
OPENAI_REALTIME_TRANSLATE_MODEL=gpt-realtime-translate
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-realtime-whisper
# near_field = headset / close mic, far_field = laptop or room mic, none = off
OPENAI_REALTIME_NOISE_REDUCTION=near_field

# Groq Whisper
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3

# Deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Edge TTS (free, no key)
EDGE_TTS_VOICE_BN=bn-BD-NabanitaNeural
# Male: ja-JP-KeitaNeural, en-US-AndrewMultilingualNeural, bn-BD-PradeepNeural
# Female: ja-JP-NanamiNeural, en-US-AvaMultilingualNeural, bn-BD-NabanitaNeural
EDGE_TTS_VOICE_JA=ja-JP-KeitaNeural
EDGE_TTS_VOICE_EN=en-US-AndrewMultilingualNeural

# ---------------------------------------------------------------------------
# Your own cloud AI
# ---------------------------------------------------------------------------
# STT: POST multipart {audio, language?} -> JSON {text, lang}
CUSTOM_STT_URL=
CUSTOM_STT_KEY=
# LLM: OpenAI-compatible base URL, e.g. http://my-vllm:8000/v1 (vLLM, Ollama, LM Studio, Groq)
CUSTOM_LLM_URL=
CUSTOM_LLM_KEY=
CUSTOM_LLM_MODEL=
# Set false if your server rejects response_format: json_object
CUSTOM_LLM_JSON_MODE=true
# low | medium | high for reasoning models (gpt-oss, Qwen3). Empty = provider default.
CUSTOM_LLM_REASONING_EFFORT=
# TTS: POST JSON {text, lang} -> audio/* bytes, or JSON {audio_base64, mime}
CUSTOM_TTS_URL=
CUSTOM_TTS_KEY=
