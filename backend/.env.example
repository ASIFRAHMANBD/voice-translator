# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
# true = canned responses + a chime sound, no AI keys needed
DEMO_MODE=true
# Optional shared secret. If set, paste the same value into the HUD's Settings > API token.
API_TOKEN=
# Comma-separated. Your extension origin, e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop
# Empty = allow any chrome-extension:// origin (fine for local dev only).
ALLOWED_ORIGINS=
MAX_UPLOAD_MB=10
PROVIDER_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Provider selection
# STT_PROVIDER: openai | groq | deepgram | custom
# LLM_PROVIDER: openai | gemini | openai-compatible (aliases: vllm, custom)
# TTS_PROVIDER: openai | elevenlabs | edge | google-translate | custom
# ---------------------------------------------------------------------------
STT_PROVIDER=openai
LLM_PROVIDER=openai
TTS_PROVIDER=edge
# Backup voice when the main one fails (Edge rate limits with HTTP 429); "none" disables it
TTS_FALLBACK_PROVIDER=google-translate
# Optional per-language voice provider, e.g. TTS_PROVIDER_JA=openai while Bangla stays on edge
TTS_PROVIDER_BN=
TTS_PROVIDER_JA=
TTS_PROVIDER_EN=
# Names/terms speech recognition should spell right, e.g. "CPL, Asif, Figma, Next.js, sprint"
STT_GLOSSARY=

# OpenAI (also used for any OpenAI-compatible base URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# whisper-1 does NOT support Bangla (HTTP 400 / garbage); gpt-transcribe does
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_LLM_MODEL=gpt-4.1-mini
# gpt-4o-mini-tts has clearly distinct male/female voices; tts-1's onyx/shimmer
# sound too similar to tell apart.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash
# Gender voices for the extension's Voice dropdown (gpt-4o-mini-tts names)
OPENAI_TTS_VOICE_MALE=onyx
OPENAI_TTS_VOICE_FEMALE=coral
# Tone for gpt-4o TTS models (ignored by tts-1). The gender is added to this
# automatically when Male or Female is picked.
OPENAI_TTS_INSTRUCTIONS=Speak like a calm, friendly professional in a business meeting. Natural pace, warm tone, clear pronunciation.

# Live simultaneous interpreter for the host's Bangla (Settings > "OpenAI live")
# Streams BN -> JA/EN speech word by word while the host talks (~$0.034/min)
OPENAI_REALTIME_TRANSLATE_MODEL=gpt-realtime-translate
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-realtime-whisper
# near_field = headset / close mic, far_field = laptop or room mic, none = off
OPENAI_REALTIME_NOISE_REDUCTION=near_field

# Groq Whisper
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3

# Deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# DeepInfra (OpenAI-compatible). Serves both the LLM and speech-to-text.
# Note: the Whisper endpoint returns nothing when the language is forced, so the
# recogniser is left to detect it and the script is fixed afterwards.
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_LLM_MODEL=google/gemma-4-31B-it
DEEPINFRA_STT_MODEL=openai/whisper-large-v3

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Gender voices for the extension's Voice dropdown; both default to ELEVENLABS_VOICE_ID
ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Edge TTS (free, no key). One male and one female voice per language, for the
# extension's Voice dropdown. Other options: ja-JP-NanamiNeural,
# en-US-AvaMultilingualNeural, bn-BD-NabanitaNeural, bn-BD-PradeepNeural.
EDGE_TTS_VOICE_BN_MALE=bn-BD-PradeepNeural
EDGE_TTS_VOICE_BN_FEMALE=bn-BD-NabanitaNeural
EDGE_TTS_VOICE_JA_MALE=ja-JP-KeitaNeural
EDGE_TTS_VOICE_JA_FEMALE=ja-JP-NanamiNeural
EDGE_TTS_VOICE_EN_MALE=en-US-AndrewMultilingualNeural
EDGE_TTS_VOICE_EN_FEMALE=en-US-AvaMultilingualNeural

# ---------------------------------------------------------------------------
# Your own cloud AI
# ---------------------------------------------------------------------------
# STT: POST multipart {audio, language?} -> JSON {text, lang}
CUSTOM_STT_URL=
CUSTOM_STT_KEY=
# LLM: OpenAI-compatible base URL, e.g. http://my-vllm:8000/v1 (vLLM, Ollama, LM Studio, Groq)
CUSTOM_LLM_URL=
CUSTOM_LLM_KEY=
CUSTOM_LLM_MODEL=
# Set false if your server rejects response_format: json_object
CUSTOM_LLM_JSON_MODE=true
# low | medium | high for reasoning models (gpt-oss, Qwen3). Empty = provider default.
CUSTOM_LLM_REASONING_EFFORT=
# TTS: POST JSON {text, lang, rate, voice} -> audio/* bytes, or JSON {audio_base64, mime}
# voice: male | female | default
CUSTOM_TTS_URL=
CUSTOM_TTS_KEY=
